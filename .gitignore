# Dependency directories (Thư mục thư viện)
node_modules/
jspm_packages/

# Logs (File log hệ thống)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data (Dữ liệu database cục bộ)
pids
*.pid
*.seed
*.pid.lock

# Environment variables (CỰC KỲ QUAN TRỌNG: Giấu mã bí mật, API key)
.env
.env.test
.env.production

# IDEs and Editors (Cấu hình riêng của trình soạn thảo)
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata (File rác của hệ điều hành)
.DS_Store
Thumbs.db

# Build output (Nếu bạn dùng TypeScript hoặc Build tool)
dist/
build/
